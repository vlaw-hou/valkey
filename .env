# ==============================================================================
# General .env template for Docker Compose stacks
# Copy this file to ".env" in the same directory as your docker-compose.yml
# Fill in / delete whichever sections don't apply to the stack you're deploying
# ==============================================================================
COMPOSE_FILE=docker-compose.yml
# ------------------------------------------------------------------------------
# Container identity / ownership
# ------------------------------------------------------------------------------
# Match these to your host user's UID/GID (check with `id kyle`) to avoid
# permission-denied errors on bind-mounted volumes.
PUID=1001
PGID=1001

# Timezone — see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Chicago

# ------------------------------------------------------------------------------
# Database credentials (Postgres / MySQL / MariaDB)
# ------------------------------------------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ------------------------------------------------------------------------------
# App-level secrets
# ------------------------------------------------------------------------------
# Generate randoms with: openssl rand -hex 32
SECRET_KEY=change-me
JWT_SECRET=change-me

# ------------------------------------------------------------------------------
# Admin / dashboard login (if the app has a built-in web UI)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ------------------------------------------------------------------------------
# Networking / URLs
# ------------------------------------------------------------------------------
# Subdomain this stack will be reverse-proxied at via Caddy
APP_DOMAIN=app.vlawnetwork.com
APP_URL=https://app.vlawnetwork.com

# ------------------------------------------------------------------------------
# S3 / object storage (if the app supports an S3-compatible backend)
# ------------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=local

# ------------------------------------------------------------------------------
# SMTP (for apps that send email — invites, notifications, password resets)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ==============================================================================
# Notes:
# - Never commit a filled-in .env to a public repo.
# - Docker Compose auto-loads a file literally named ".env" sitting next to
#   docker-compose.yml — no extra config needed.
# - Reference any of these in compose with ${VARIABLE_NAME}.
# ==============================================================================
